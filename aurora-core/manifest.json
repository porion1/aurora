        {"name": "getCurrentTenantId", "description": "Get current tenant ID"},
        {"name": "isDedicated", "description": "Check if current tenant uses dedicated DB"},
        {"name": "withTenant", "description": "Execute block with tenant context"},
        {"name": "withTenantAndDedicated", "description": "Execute block with explicit dedicated flag"},
        {"name": "setFullContext", "description": "Set both tenant and config context"},
        {"name": "withFullTenant", "description": "Execute block with full context"}
      ],
      "files": [
        "src/main/scala/com/aurora/tenant/TenantContext.scala"
      ]
    },
